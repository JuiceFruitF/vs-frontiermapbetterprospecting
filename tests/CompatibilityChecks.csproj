<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY_PATH)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <FrontiersMapPath Condition="'$(FrontiersMapPath)' == ''">$(MSBuildProjectDirectory)/../references/ItemFrontiersMap.dll</FrontiersMapPath>
    <BetterErProspectingPath Condition="'$(BetterErProspectingPath)' == ''">$(MSBuildProjectDirectory)/../references/BetterErProspecting.dll</BetterErProspectingPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/FrontierMapBetterProspecting.csproj" />
    <Reference Include="VintagestoryAPI" HintPath="$(VintageStoryPath)/VintagestoryAPI.dll" />
    <Reference Include="VintagestoryLib" HintPath="$(VintageStoryPath)/VintagestoryLib.dll" />
    <Reference Include="VSSurvivalMod" HintPath="$(VintageStoryPath)/Mods/VSSurvivalMod.dll" />
    <Reference Include="VSEssentials" HintPath="$(VintageStoryPath)/Mods/VSEssentials.dll" />
    <Reference Include="0Harmony" HintPath="$(VintageStoryPath)/Lib/0Harmony.dll" />
    <Reference Include="ItemFrontiersMap" HintPath="$(FrontiersMapPath)" />
    <Reference Include="BetterErProspecting" HintPath="$(BetterErProspectingPath)" />
  </ItemGroup>
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <RuntimeDependency Include="$(VintageStoryPath)/Lib/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDependency)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
